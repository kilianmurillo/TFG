<?xml version="1.0"?>
<robot name="view_robot_pkg">

  <!-- ============================================== -->
  <!-- BASE LINK                                      -->
  <!-- ============================================== -->
  <link name="base_link">
  </link>

  <!-- ============================================== -->
  <!-- CHASIS                                         -->
  <!-- ============================================== -->
  <link name="chasis_link">
    <inertial>
      <origin xyz="-0.00792683715961234 4.84292477568454E-06 0.00696138459195617" rpy="0 0 0" />
      <mass value="31.0510588516386" />
      <inertia
        ixx="0.546100742622529"
        ixy="-1.20474479344407E-05"
        ixz="-0.0684418041136963"
        iyy="0.530661571082809"
        iyz="-2.01857618659373E-05"
        izz="0.805300932830766" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://view_robot_pkg/meshes/chasis_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://view_robot_pkg/meshes/chasis_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="chasis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chasis_link"/>
    <origin xyz="0 0 0.13"/>
  </joint>

  <!-- ============================================== -->
  <!-- RUEDA LOCA / CASTER (FIJA)                     -->
  <!-- ============================================== -->
  <link name="rueda_link">
    <inertial>
      <origin xyz="0.0015857583067285 1.41933265487837E-10 -0.000713406850621004" rpy="0 0 0" />
      <mass value="0.498106960681791" />
      <inertia
        ixx="0.0002566933502602"
        ixy="1.71036192508585E-13"
        ixz="-9.3219390927489E-06"
        iyy="0.000256159949297888"
        iyz="-4.40885903396754E-13"
        izz="0.00041907421932662" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://view_robot_pkg/meshes/rueda_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.298039215686275 0.298039215686275 0.298039215686275 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://view_robot_pkg/meshes/rueda_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rueda_joint" type="fixed">
    <!-- Corregida la posición Y a 0.0 para centrarla perfectamente -->
    <origin xyz="0.1431 0.0 -0.071566" rpy="1.5708 0 1.628" />
    <parent link="chasis_link" />
    <child link="rueda_link" />
    <axis xyz="0 0 0" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- ============================================== -->
  <!-- RUEDA IZQUIERDA                                -->
  <!-- ============================================== -->
  <link name="izquierda_link">
    <inertial>
      <origin xyz="0.00158575847708342 2.35922392732846E-16 -0.000713406902613289" rpy="0 0 0" />
      <mass value="0.498106962507464" />
      <inertia
        ixx="0.00025669335009819"
        ixy="3.98516365605981E-14"
        ixz="-9.32193882960599E-06"
        iyy="0.000256159949639378"
        iyz="2.28023974601996E-15"
        izz="0.00041907421916061" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://view_robot_pkg/meshes/izquierda_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.498039215686275 0.498039215686275 0.498039215686275 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://view_robot_pkg/meshes/izquierda_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="izquierda_joint" type="continuous">
    <!-- Posición simétrica corregida (X=-0.12, Y=0.152) -->
    <origin xyz="-0.12 0.152 -0.071566" rpy="1.5708 0 -2.5608" />
    <parent link="chasis_link" />
    <child link="izquierda_link" />
    <axis xyz="-0.057126 0 0.99837" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- ============================================== -->
  <!-- RUEDA DERECHA                                  -->
  <!-- ============================================== -->
  <link name="derecha_link">
    <inertial>
      <origin xyz="0.00158575842790139 1.84338477642043E-10 -0.000713406924709281" rpy="0 0 0" />
      <mass value="0.498106961858572" />
      <inertia
        ixx="0.000256693350168297"
        ixy="6.14266891937472E-14"
        ixz="-9.32193834236271E-06"
        iyy="0.000256159949443386"
        iyz="1.72002063922267E-13"
        izz="0.000419074219282646" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://view_robot_pkg/meshes/derecha_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.498039215686275 0.498039215686275 0.498039215686275 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://view_robot_pkg/meshes/derecha_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="derecha_joint" type="continuous">
    <!-- Posición simétrica corregida (X=-0.12, Y=-0.152) -->
    <origin xyz="-0.12 -0.152 -0.071566" rpy="1.5708 0 -0.46644" />
    <parent link="chasis_link" />
    <child link="derecha_link" />
    <!-- Signos del eje invertidos para corregir el sentido de giro -->
    <axis xyz="0.057126 0 -0.99837" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- ============================================== -->
  <!-- CONFIGURACIÓN DE FRICCIÓN PARA GAZEBO          -->
  <!-- ============================================== -->
  <!-- Fricción cero en la rueda loca para que no arrastre el robot -->
  <gazebo reference="rueda_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <!-- ============================================== -->
  <!-- PLUGIN DE GAZEBO HARMONIC (Manejo del robot)   -->
  <!-- ============================================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>izquierda_joint</left_joint>
      <right_joint>derecha_joint</right_joint>
      
      <wheel_separation>0.304</wheel_separation>
      <wheel_radius>0.07</wheel_radius>
      
      <odom_publish_frequency>50</odom_publish_frequency>
      
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

</robot>