<launch>
    <let name="urdf_path" 
            value="$(find-pkg-share robotino_description)/urdf/robotino_description.urdf.xacro" />
    <let name="rviz_config_path" 
            value="$(find-pkg-share robotino_description)/rviz/urdf_config.rviz" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" 
                value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <node pkg="controller_manager" exec="ros2_control_node">
        <param find-pkg-share="$(find-pkg-share robotino_bringup)/config/robotino_controllers.yaml" />
    </node>

    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster" />

    <node pkg="controller_manager" exec="spawner" args=  />
    <!-- En args hay que poner el controlador omnidireccional -->

    <node pkg="rviz2" exec="rviz2" output="screen" 
            args="-d $(var rviz_config_path)" />

</launch>
