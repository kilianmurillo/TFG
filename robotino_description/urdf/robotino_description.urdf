<?xml version="1.0" encoding="utf-8"?>
<robot name="robotino_description">

  <!-- Enlace ficticio proyectado a ras de suelo -->
  <link name="base_footprint"/>

  <!-- Unión que eleva el robot 6 cm desde el suelo -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- Enlace central del robot -->
  <link name="base_link"/>

  <!-- Unión entre base_link y el chasis 3D -->
  <joint name="chasis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chasis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

