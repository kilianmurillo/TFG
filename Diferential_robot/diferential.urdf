<?xml version="1.0"?>
<robot name="diferential">

<material name="yellow">
    <color rgba="1 1 0 0.5"/>
</material>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <material name="yellow" />
        </visual>
    </link>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
    </link>

    <joint name="base_sleft_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0.15 0.225 0.1" rpy="1.570796 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

</robot>